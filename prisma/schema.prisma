generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PlaylistSong {
  playlist    Playlist @relation(fields: [playlist_id], references: [id], onDelete: Cascade)
  playlist_id String

  song        Song     @relation(fields: [song_id], references: [id], onDelete: Cascade)
  song_id     String

  added_at    DateTime @default(now()) // Fecha en que se agregó la canción a la playlist

  @@id([playlist_id, song_id]) // Clave primaria compuesta
  @@map("playlist_songs")
}

model Playlist {
  id         String   @id @default(uuid())
  name           String           @db.VarChar(255)
  description    String?
  cover         String?
  created_at       DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  songs PlaylistSong[]

    @@map("playlists")
}

model Song {
  id         String   @id @default(uuid())
  title      String   @db.VarChar(255)
  artist     String   @db.VarChar(255)
  image_url  String   @db.VarChar(500)
  audio_url  String   @db.VarChar(500)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  playlist   PlaylistSong[]

  @@map("songs")
}
